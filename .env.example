# Hermes Mobile — local development environment
#
# Copy this file to .env and fill in your local settings.
# Never commit .env, .env.local, or any file containing real credentials.
#
# Placeholders only — no real secrets here.

# URL of the local Hermes API server (default dev port)
VITE_HERMES_API_URL=http://127.0.0.1:8642

# The mobile app pairs at runtime and stores this key in Android Keystore.
# Do not put a real key in a Vite environment file or bundle it into an APK.
# CORS origins that the API server should accept (comma-separated)
# For development with Capacitor on Android, include capacitor://localhost
VITE_CORS_ORIGINS=http://localhost,capacitor://localhost

# (optional) Override the Hermes API server host for emulator testing
# When using the Android emulator, 10.0.2.2 maps to the host loopback.
# VITE_HERMES_API_URL=http://10.0.2.2:8642
